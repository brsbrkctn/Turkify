# =========================================================
# Turkify: Environment Configuration
# =========================================================

# Supabase (Kalıcı PostgreSQL önbellekleme için)
# Boş bırakılırsa eklenti bellek içi (in-memory) önbellek ile çalışmaya devam eder.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_anon_key

# TMDB (The Movie Database) API Anahtarı (İsteğe bağlı)
# Girilirse resmi Türkçe film/dizi veritabanını öncelikli kullanır.
# Boş bırakılırsa eklenti ücretsiz Google Translate motoru ile otomatik çevirir.
TMDB_API_KEY=
